# Finais de linha: LF no repositório e na cópia de trabalho, em qualquer sistema.
* text=auto eol=lf

# Binários: nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary

# SVG é texto.
*.svg text eol=lf
