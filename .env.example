# URL do projeto Supabase (local: http://127.0.0.1:44321)
VITE_SUPABASE_URL=
# Chave publicável (publishable/anon) do Supabase. Nunca use a service_role aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Chave pública VAPID (Web Push). Pública por natureza; a privada fica só nos secrets da Edge Function.
# Local: `npm run vapid:gerar` imprime a linha pronta para o .env.local.
VITE_VAPID_PUBLIC_KEY=
# Link de download do APK Android (opcional). Sem ele, o guia /instalar não mostra "Baixar o APK".
VITE_APK_DOWNLOAD_URL=
# Site key pública do Cloudflare Turnstile (opcional). Sem ela, não há CAPTCHA. O segredo fica só no painel do Supabase (Auth > Attack Protection).
VITE_TURNSTILE_SITE_KEY=
# Responsável pelo serviço, exibido em /privacidade (opcionais; sem eles a página avisa que o contato não foi informado).
# O e-mail só é usado se for válido.
VITE_PRIVACY_CONTROLLER_NAME=
VITE_PRIVACY_CONTACT_EMAIL=
# --- APK Android (só no build/geração do APK; não são lidas pelo app) ---
# ID do pacote do APK (ex.: o mesmo informado no `bubblewrap init`). Com a impressão abaixo, o build publica /.well-known/assetlinks.json.
# ANDROID_PACKAGE_ID=
# Impressão SHA-256 do certificado de assinatura (AA:BB:...); várias, separadas por vírgula.
# ANDROID_CERT_SHA256=
# --- Publicação no Cloudflare Pages (só `npm run publicar:site`, no .env.production.local; não são lidas pelo app) ---
# Nome do projeto no Cloudflare Pages (minúsculas, números e hífens).
# CF_PAGES_PROJECT=
# Branch de produção com que o projeto foi criado: a publicação sempre vai para ele (nunca para uma prévia).
# CF_PAGES_BRANCH=master
