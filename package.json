{
  "name": "clanix-agenda",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase db reset && supabase test db",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "vapid:gerar": "node scripts/gerar-vapid.mjs",
    "lembretes:local": "node scripts/configurar-lembretes-local.mjs",
    "verificar:producao": "node scripts/verificar-producao.mjs",
    "publicar:site": "node scripts/publicar-site.mjs",
    "backup:producao": "node scripts/backup-producao.mjs",
    "dados:teste": "node scripts/dados-teste-local.mjs",
    "marca:copiar": "node scripts/copiar-marca.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": ">=5.9 <6.1",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "web-push": "^3.6.7",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "4.151.3"
